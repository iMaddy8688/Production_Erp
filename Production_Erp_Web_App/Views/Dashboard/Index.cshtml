@model Production_Erp_Web_App.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <div class="text-uppercase small">Items</div>
                <div class="fs-2 fw-bold">@Model.TotalItems</div>
                <div class="small">@Model.LowStockItems low stock</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <div class="text-uppercase small">Customers</div>
                <div class="fs-2 fw-bold">@Model.TotalCustomers</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <div class="text-uppercase small">Suppliers</div>
                <div class="fs-2 fw-bold">@Model.TotalSuppliers</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-secondary h-100">
            <div class="card-body">
                <div class="text-uppercase small">Employees</div>
                <div class="fs-2 fw-bold">@Model.TotalEmployees</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-uppercase small text-muted">Sales</div>
                <div class="fs-3 fw-bold">@Model.TotalSalesInvoices invoices</div>
                <div class="text-muted">Total: &#8377;@Model.TotalSalesAmount.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-uppercase small text-muted">Purchases</div>
                <div class="fs-3 fw-bold">@Model.TotalPurchaseInvoices invoices</div>
                <div class="text-muted">Total: &#8377;@Model.TotalPurchaseAmount.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

@if (Model.TotalItems == 0 && Model.TotalCustomers == 0 && Model.TotalSuppliers == 0)
{
    <div class="alert alert-info mt-4" role="alert">
        This dashboard reads live from SQL Server via Entity Framework Core — every number above is a real
        query, not a placeholder. It shows zero right now because Master Data (Items, Customers, Suppliers,
        Employees) hasn't been entered yet and no Sales/Purchase invoices exist. Once the Master Data and
        Purchase/Sales modules are built, this page updates automatically with no further changes needed here.
    </div>
}
