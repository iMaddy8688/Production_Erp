@model Production_Erp_Web_App.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon icon-primary"><i class="bi bi-box-seam"></i></div>
                <div>
                    <div class="text-uppercase small text-muted">Items</div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalItems</div>
                    <div class="small text-muted">@Model.LowStockItems low stock</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon icon-success"><i class="bi bi-person-check"></i></div>
                <div>
                    <div class="text-uppercase small text-muted">Customers</div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalCustomers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon icon-info"><i class="bi bi-truck"></i></div>
                <div>
                    <div class="text-uppercase small text-muted">Suppliers</div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalSuppliers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon icon-secondary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-uppercase small text-muted">Employees</div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalEmployees</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon icon-primary"><i class="bi bi-graph-up-arrow"></i></div>
                <div>
                    <div class="text-uppercase small text-muted">Sales</div>
                    <div class="fs-4 fw-bold lh-1">@Model.TotalSalesInvoices invoices</div>
                    <div class="text-muted small mt-1">Total: &#8377;@Model.TotalSalesAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon icon-warning"><i class="bi bi-cart-check"></i></div>
                <div>
                    <div class="text-uppercase small text-muted">Purchases</div>
                    <div class="fs-4 fw-bold lh-1">@Model.TotalPurchaseInvoices invoices</div>
                    <div class="text-muted small mt-1">Total: &#8377;@Model.TotalPurchaseAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card panel-card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-receipt text-muted"></i>Recent Sales Invoices
            </div>
            <div class="card-body p-0">
                @if (Model.RecentSales.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox" style="font-size:2rem;"></i>
                        <p class="mb-0 mt-2">No sales invoices yet.</p>
                        <p class="small">Once the Sales module is live, the latest invoices show up here automatically.</p>
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.RecentSales)
                            {
                                <tr>
                                    <td>@row.InvoiceNumber</td>
                                    <td>@row.PartyName</td>
                                    <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="text-end">&#8377;@row.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card panel-card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-receipt-cutoff text-muted"></i>Recent Purchase Invoices
            </div>
            <div class="card-body p-0">
                @if (Model.RecentPurchases.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox" style="font-size:2rem;"></i>
                        <p class="mb-0 mt-2">No purchase invoices yet.</p>
                        <p class="small">Once the Purchase module is live, the latest bills show up here automatically.</p>
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Supplier</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.RecentPurchases)
                            {
                                <tr>
                                    <td>@row.InvoiceNumber</td>
                                    <td>@row.PartyName</td>
                                    <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="text-end">&#8377;@row.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.TotalItems == 0 && Model.TotalCustomers == 0 && Model.TotalSuppliers == 0)
{
    <div class="alert alert-info mt-4" role="alert">
        <i class="bi bi-info-circle me-1"></i>
        This dashboard reads live from SQL Server via Entity Framework Core — every number and table above is
        a real query, not a placeholder. It's empty right now because Master Data (Items, Customers, Suppliers,
        Employees) hasn't been entered yet and no Sales/Purchase invoices exist. Once the Master Data and
        Purchase/Sales modules are built, this page updates automatically with no further changes needed here.
    </div>
}
